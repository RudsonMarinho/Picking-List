APP_PORT=
APP_ENV=
ERROR_ID_PREFIX=INV

# P1: DB_USER e DB_MIGRATE_USER são roles distintos — PROIBIDO usar o mesmo
# usuário para runtime e migrations (anularia RLS/least privilege).
# DB_USER        = invtech_app   (runtime — só CRUD, sem DDL, NOBYPASSRLS)
# DB_MIGRATE_USER = invtech_owner (só golang-migrate + scripts/bootstrap_db.sh)
# Valores reais provisionados no Coolify — nunca hardcoded aqui.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_MIGRATE_USER=
DB_MIGRATE_PASSWORD=

SESSION_COOKIE_NAME=
CSRF_COOKIE_NAME=

MAIL_DRIVER=
AUTO_CONFIRM_SIGNUP=
FEATURE_PUBLIC_SIGNUP=
FEATURE_BILLING=
FEATURE_EMAIL_DELIVERY=
